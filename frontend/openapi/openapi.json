  "components": {
    "schemas": {
      "CreateTenantRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "TenantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssessmentPart": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "templateId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "templateVersion": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "status": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "organizationId",
          "status",
          "templateId",
          "templateVersion"
        ]
      },
      "CalculateRequest": {
        "type": "object",
        "properties": {
          "assessment": {
            "$ref": "#/components/schemas/AssessmentPart"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputPart"
            },
            "maxItems": 1000,
            "minItems": 0
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponsePart"
            },
            "maxItems": 20000,
            "minItems": 0
          }
        },
        "required": [
          "assessment"
        ]
      },
      "InputPart": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "answer": {},
          "questionType": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          }
        },
        "required": [
          "questionId"
        ]
      },
      "ResponsePart": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "answer": {},
          "questionType": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          "scope": {
            "type": "string",
            "maxLength": 16,
            "minLength": 0
          },
          "teamId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "respondents": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "questionId",
          "scope"
        ]
      },
      "CountsResponse": {
        "type": "object",
        "properties": {
          "matchedPatterns": {
            "type": "integer",
            "format": "int32"
          },
          "appliedPenalties": {
            "type": "integer",
            "format": "int32"
          },
          "suppressedPenalties": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DimensionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "rawScore": {
            "type": "number"
          },
          "effectivePenalty": {
            "type": "number"
          },
          "adjustedScore": {
            "type": "number"
          },
          "coverage": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "weightedContribution": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "JsonNode": {},
      "OverallResponse": {
        "type": "object",
        "properties": {
          "weightedAdjustedScore": {
            "type": "number"
          },
          "effectiveOverallPenalty": {
            "type": "number"
          },
          "finalScore": {
            "type": "number"
          }
        }
      },
      "ScoringResultResponse": {
        "type": "object",
        "properties": {
          "scoringRunId": {
            "type": "string",
            "format": "uuid"
          },
          "assessmentId": {
            "type": "string"
          },
          "assessmentSnapshotId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "configurationSelection": {
            "type": "string"
          },
          "engineVersion": {
            "type": "string"
          },
          "algorithmVersion": {
            "type": "string"
          },
          "configurationVersion": {
            "type": "string"
          },
          "configurationHash": {
            "type": "string"
          },
          "inputHash": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "scoreStatus": {
            "type": "string"
          },
          "leadershipIntelligenceScore": {
            "type": "number"
          },
          "interpretation": {
            "type": "string"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DimensionResponse"
            }
          },
          "overall": {
            "$ref": "#/components/schemas/OverallResponse"
          },
          "imbalances": {
            "$ref": "#/components/schemas/JsonNode"
          },
          "patterns": {
            "$ref": "#/components/schemas/JsonNode"
          },
          "penalties": {
            "$ref": "#/components/schemas/JsonNode"
          },
          "counts": {
            "$ref": "#/components/schemas/CountsResponse"
          },
          "errorCode": {
            "type": "string"
          },
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "explanationReference": {
            "type": "string",
            "format": "uuid"
