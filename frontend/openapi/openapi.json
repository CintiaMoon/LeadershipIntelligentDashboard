{
  "openapi": "3.1.0",
  "info": {
    "title": "Leadership Intelligence Scoring Engine",
    "description": "Deterministic, explainable organizational scoring. The score is an organizational diagnostic signal, not an individual performance rating and not a basis for employment decisions.",
    "version": "3.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/platform/tenants": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Every tenant (platform administrators only; the read is audited)",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TenantListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Platform"
        ],
        "summary": "Create a tenant (platform administrators only; audited)",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculate": {
      "post": {
        "tags": [
          "Scoring"
        ],
        "summary": "Submit an assessment and its answers, score it and store the run",
        "operationId": "calculate",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringResultResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{assessmentId}/score": {
