# Development uses the application own accounts by default (VITE_AUTH_MODE=session): register, confirm the email in Mailpit (http://localhost:8025),
# sign in. For the external provider with its persona picker run `npm run dev:oidc` instead (see .env.oidc).
# Local development against `docker compose up -d postgres mock-oauth2 app` (see ../docker-compose.yml).
VITE_OIDC_AUTHORITY=http://localhost:8081/default
VITE_OIDC_CLIENT_ID=lis-web
# The persona picker is a development convenience that sets the OIDC client_id of the local mock identity provider.
VITE_DEV_PERSONAS=true
